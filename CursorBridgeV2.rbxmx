	Monochrome = {
		Background = Color3.fromRGB(10, 10, 10),
		Surface = Color3.fromRGB(16, 16, 16),
		SurfaceRaised = Color3.fromRGB(22, 22, 22),
		SurfaceHover = Color3.fromRGB(30, 30, 30),
