{
  "name": "cursor-bridge",
  "version": "0.4.2",
  "description": "Local Roblox Studio-to-Windows Luau bridge with two-way synchronization and backups",
  "private": true,
  "author": "Cursor Bridge Contributors",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "python tests/browser/smoke.py && python tests/browser/workbench.py && python tests/browser/quick_apply.py && python tests/browser/navigation.py && python tests/browser/sync_regression.py",
    "test:load": "node --test tests/large-place.test.cjs tests/virtual-window.test.cjs",
    "test:ui:load": "python tests/browser/large_place.py && python tests/browser/on_demand.py",
    "test:stability": "node --test tests/quick-apply-recovery.test.cjs",
    "test:ui:stability": "python tests/browser/quick_apply_large.py",
    "test:ui:workspace": "python tests/browser/workspace.py && python tests/browser/minimal_ui.py"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "monaco-editor": "0.57.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.cursor.bridge",
    "productName": "Cursor Bridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "bridge/**/*",
      "dist-renderer/**/*",
      "assets/**/*",
      "package.json",
      "shared/**/*"
    ],
    "win": {
      "icon": "assets/CursorIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cursor-Bridge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nikis-gif",
        "repo": "CursorBridge",
        "releaseType": "release"
      }
    ]
  }
}
