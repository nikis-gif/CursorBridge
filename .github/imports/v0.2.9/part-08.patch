diff --git a/tests/quick-apply-recovery.test.cjs b/tests/quick-apply-recovery.test.cjs
new file mode 100644
--- /dev/null
+++ b/tests/quick-apply-recovery.test.cjs
@@ -0,0 +1,207 @@
+'use strict';
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const {BridgeServer} = require('../bridge/bridge-server.cjs');
+const {parseBundle,MAX_BUNDLE_BYTES,MAX_SCRIPTS} = require('../bridge/quick-apply.cjs');
+const {encodeTransfer,IncomingTransfer,OutgoingTransfers} = require('../bridge/wire-transfer.cjs');
+const limits = require('../shared/limits.json');
+
+const line = '='.repeat(50);
+function bundle(source = '--!strict\nprint("updated")\n', status = 'MODIFIED', dest = 'game/ServerScriptService/Gameplay/Services/JumpSystemService') {
+  return `${line}\nSCRIPT: ${dest.split('/').at(-1)}\nPATH: ${dest}\nSTATUS: ${status}\n${line}\n\n${source}`;
+}
+const nodes = [
+  {id:'s',parentId:'game',name:'ServerScriptService',className:'ServerScriptService',hasChildren:true},
+  {id:'g',parentId:'s',name:'Gameplay',className:'Folder',hasChildren:true},
+  {id:'f',parentId:'g',name:'Services',className:'Folder',hasChildren:true},
+  {id:'j',parentId:'f',name:'JumpSystemService',className:'ModuleScript',source:'--!strict\nreturn {}\n'},
+];
+async function harness(t) {
+  const storageDir = await fs.mkdtemp(path.join(os.tmpdir(),'cursor-v029-'));
+  const clock = {value:10_000_000};
+  const bridge = new BridgeServer({storageDir,port:0,now:()=>clock.value});
+  await bridge.start(); clearInterval(bridge.timer);
+  const paired = bridge.pair({code:bridge.pairingCode,studioRunId:'live-studio-process',placeKey:'1-2',placeName:'Test',protocolVersion:2});
+  await bridge.receiveChanges({sequence:1,ops:[{type:'scanBegin'},{type:'upsert',node:nodes[0]},{type:'ready'}]});
+  t.after(async()=>{await bridge.close();await fs.rm(storageDir,{recursive:true,force:true});});
+  return {bridge,clock,paired,storageDir};
+}
+async function preview(bridge, text=bundle(), resolved=nodes, errors=[]) {
+  const promise = bridge.previewQuickApply(text);
+  const request = bridge.pathResolution;
+  assert.equal(request.command.type,'resolvePaths');
+  await bridge.receiveChanges({sequence:bridge.session.lastSeq+1,ops:[{type:'resolvedPaths',opId:request.opId,nodes:resolved,errors}]});
+  return promise;
+}
+
+test('closed deep paths resolve during indexing without loading sibling pages or editing Studio', async t=>{
+  const {bridge}=await harness(t);
+  assert.equal(bridge.indexing,true);
+  const plan=await preview(bridge);
+  assert.equal(plan.ok,true); assert.equal(plan.summary.modify,1);
+  assert.equal(bridge.childPages.size,0); assert.equal(bridge.pendingQuickApply,null);
+  const applied=await bridge.applyQuickApply(plan.token);
+  assert.equal(applied.status,'queued');
+  assert.equal(bridge.nodes.get('j').source,nodes[3].source);
+});
+test('remote duplicate path is never hidden by partial Explorer state', async t=>{
+  const {bridge}=await harness(t);
+  const plan=await preview(bridge,bundle(),nodes,[{index:0,message:'Ambiguous path: duplicate Services.'}]);
+  assert.equal(plan.ok,false);assert.match(plan.errors[0].message,/Ambiguous/);
+  await assert.rejects(bridge.applyQuickApply(plan.token),/preview errors/);
+});
+test('missing MODIFIED is an error, while NEW plans folders without creating them in preview', async t=>{
+  const {bridge}=await harness(t);
+  const missing=await preview(bridge,bundle(),[nodes[0]],[{index:0,message:'MODIFIED destination was not found.'}]);
+  assert.equal(missing.ok,false); assert.equal(bridge.nodes.size,1);
+  const fresh=await preview(bridge,bundle('--!strict\nreturn {}','NEW'),[nodes[0]]);
+  assert.equal(fresh.ok,true);assert.deepEqual(fresh.entries[0].missingFolders,['Gameplay','Services']);
+  assert.equal(bridge.nodes.size,1);
+});
+test('changed source invalidates resolved preview instead of overwriting Studio',async t=>{
+  const {bridge}=await harness(t);const plan=await preview(bridge);
+  await bridge.applyOperation({type:'source',id:'j',source:'--!strict\nprint("external")\n'});
+  await assert.rejects(bridge.applyQuickApply(plan.token),/source changed since preview/);
+});
+test('a new preview cancels older work; disconnect rejects pending resolution',async t=>{
+  const {bridge}=await harness(t);
+  const old=bridge.previewQuickApply(bundle());const rejected=assert.rejects(old,/newer preview/);
+  const current=bridge.previewQuickApply(bundle());await rejected;
+  const closing=assert.rejects(current,/disconnected while resolving/);
+  await bridge.disconnect('user-disconnected');await closing;
+  assert.equal(bridge.pathResolution,null);
+});
+test('input larger than browser cache capacity persists atomically on disk',async t=>{
+  const {bridge}=await harness(t);const text='-- input\n'.repeat(800000);
+  await bridge.saveQuickApplyDraft(text);assert.equal(await bridge.getQuickApplyDraft(),text);
+  await bridge.saveQuickApplyDraft('newer');
+  await assert.rejects(bridge.saveQuickApplyDraft('x'.repeat(MAX_BUNDLE_BYTES+1)),/16 MiB/);
+  assert.equal(await bridge.getQuickApplyDraft(),'newer');
+});
+test('128-entry and large-source bundles accepted; size limits explicitly rejected',()=>{
+  assert.equal(parseBundle(bundle('--!strict\n-- '+ 'a'.repeat(1024*1024),'NEW')).length,1);
+  const many=Array.from({length:MAX_SCRIPTS},(_,i)=>bundle('--!strict\nreturn {}','NEW',`game/ServerScriptService/M${i}`)).join('\n');
+  assert.equal(parseBundle(many).length,128);
+  assert.throws(()=>parseBundle(many+'\n'+bundle()),/at most 128/);
+  assert.throws(()=>parseBundle(bundle('--!strict\n'+ 'x'.repeat(limits.maxScriptBytes))),/2 MiB/);
+});
+test('UTF-8 and escaped source survive fragmentation and duplicate fragments',()=>{
+  const value={type:'source',id:'large',source:'--!strict\n'+ '"\\\u0001\u{1F642}\n'.repeat(150000)};
+  const parts=encodeTransfer(value); assert.ok(parts.length>10);
+  const receiver=new IncomingTransfer();let completed;
+  for(let i=0;i<parts.length;i++) {
+    assert.ok(Buffer.byteLength(JSON.stringify(parts[i]))<limits.maxPacketBytes);
+    const result=receiver.accept(parts[i]);
+    assert.deepEqual(receiver.accept(parts[i]),result);
+    if(result.value) completed=result.value;
+  }
+  assert.deepEqual(completed,value); receiver.commit(parts[0].id);
+  assert.equal(receiver.active,null);assert.equal(receiver.completed,null);
+});
+test('corrupted, mismatched and out-of-order fragments cannot form commands',()=>{
+  const parts=encodeTransfer({type:'source',source:'x'.repeat(100000)});
+  assert.throws(()=>new IncomingTransfer().accept(parts[1]),/start/);
+  const first=new IncomingTransfer();first.accept(parts[0]);
+  assert.throws(()=>first.accept({...parts[1],id:'another'}),/identity/);
+  const corrupt=new IncomingTransfer();corrupt.accept(parts[0]);
+  assert.throws(()=>corrupt.accept({...parts[1],data:'y'+parts[1].data.slice(1)}),/checksum/);
+});
+test('large commands retry exact fragments and release caches after result',()=>{
+  const value={type:'quickApply',opId:'one',entries:[{source:'"\\'.repeat(700000)}]};
+  const sender=new OutgoingTransfers(),receiver=new IncomingTransfer();let completed,rounds=0;
+  while(!completed) {
+    const packet=sender.pack([value]);
+    assert.ok(Buffer.byteLength(JSON.stringify({commands:packet}))<limits.maxPacketBytes);
+    if(rounds===0)assert.deepEqual(sender.pack([value]),packet);
+    for(const chunk of packet){const progress=receiver.accept(chunk);sender.receipts([{id:chunk.id,next:progress.next}]);if(progress.value)completed=progress.value;}
+    if(++rounds>200)throw Error('Transfer failed to converge.');
+  }
+  assert.deepEqual(completed,value);assert.deepEqual(sender.pack([value]),[]);
+  sender.pack([]);assert.equal(sender.items.size,0);
+});
+test('96 hours of accelerated idle heartbeats retain the same healthy session',async t=>{
+  const {bridge,clock,paired}=await harness(t);const session=bridge.session;
+  for(let i=0;i<96*3600/1.5;i++) {clock.value+=1500;bridge.authenticate({headers:{authorization:`Bearer ${paired.token}`}});bridge.tick();}
+  assert.equal(bridge.session,session);assert.equal(bridge.session.lastSeq,1);assert.equal(bridge.getStatus().ready,true);
+});
+test('temporary lost heartbeat becomes read-only, then recovers in the same session',async t=>{
+  const {bridge,clock,paired}=await harness(t);clock.value+=20000;bridge.tick();
+  assert.equal(bridge.getStatus().ready,false);assert.equal(bridge.getStatus().recovering,true);
+  await assert.rejects(bridge.writeScript('j','x',0),/not connected/);
+  bridge.authenticate({headers:{authorization:`Bearer ${paired.token}`}});assert.equal(bridge.getStatus().ready,true);
+});
+test('expiry resumes only original token, Place and process; unknown operations are not replayed',async t=>{
+  const {bridge,clock,paired}=await harness(t);const plan=await preview(bridge);await bridge.applyQuickApply(plan.token);
+  const events=[];bridge.on('event',e=>events.push(e));await bridge.disconnect('heartbeat-timeout');
+  assert.equal(bridge.session,null);assert.ok(events.some(e=>e.type==='quickApply'&&e.status==='unknown'));
+  assert.throws(()=>bridge.resume({studioRunId:'live-studio-process',placeKey:'1-2'},'wrong'),/authorization/);
+  assert.throws(()=>bridge.resume({studioRunId:'other-process',placeKey:'1-2'},paired.token),/authorization/);
+  assert.throws(()=>bridge.resume({studioRunId:'live-studio-process',placeKey:'other'},paired.token),/authorization/);
+  clock.value+=4*3600_000;const result=bridge.resume({studioRunId:'live-studio-process',placeKey:'1-2'},paired.token);
+  assert.notEqual(result.sessionId,paired.sessionId);assert.equal(result.reset,true);
+  assert.equal(bridge.pendingQuickApply,null);assert.deepEqual(bridge.poll().commands,[]);assert.equal(bridge.nodes.size,0);
+});
+test('explicit disconnect and new pairing revoke old automatic recovery permission',async t=>{
+  const {bridge,paired}=await harness(t);await bridge.disconnect('heartbeat-timeout');await bridge.disconnect('application-user-disconnected');
+  assert.throws(()=>bridge.resume({studioRunId:'live-studio-process',placeKey:'1-2'},paired.token),/authorization/);
+  bridge.pair({code:bridge.pairingCode,studioRunId:'new-studio-process',placeKey:'1-2',protocolVersion:2});
+  assert.throws(()=>bridge.resume({studioRunId:'live-studio-process',placeKey:'1-2'},paired.token),/already paired/);
+});
+test('80 hours of simulated OS suspension waits for a real heartbeat after wake',async t=>{
+  const {bridge,clock,paired}=await harness(t);bridge.suspendForSleep();clock.value+=80*3600_000;bridge.tick();
+  assert.ok(bridge.session);assert.equal(bridge.getStatus().ready,false);bridge.resumeFromSleep();bridge.tick();
+  assert.equal(bridge.getStatus().ready,false);bridge.authenticate({headers:{authorization:`Bearer ${paired.token}`}});
+  assert.equal(bridge.getStatus().ready,true);
+});
+test('actual localhost exchange handles a large fragmented source and lost-response retries',async t=>{
+  const {bridge,paired}=await harness(t);await bridge.applyOperation({type:'upsert',node:nodes[3]});
+  const url=`http://127.0.0.1:${bridge.httpServer.address().port}/v2/exchange`;
+  const headers={'content-type':'application/json','x-cursor-bridge':'1',authorization:`Bearer ${paired.token}`};
+  const source='--!strict\n-- '+ '"\\'.repeat(700000);const parts=encodeTransfer({type:'source',id:'j',source});
+  for(const part of parts) {
+    const sequence=bridge.session.lastSeq+1;const body=JSON.stringify({sequence,ops:[part],receipts:[]});
+    for(let retry=0;retry<2;retry++) {
+      const response=await fetch(url,{method:'POST',headers,body});assert.equal(response.status,200);
+      assert.equal((await response.json()).receivedSequence,sequence);
+    }
+  }
+  assert.equal(bridge.nodes.get('j').source,source);assert.equal(bridge.nodes.get('j').revision,2);
+});
+test('empty destination source remains an empty string in the write guard',async t=>{
+  const {bridge}=await harness(t);const plan=await preview(bridge,bundle(),nodes.map(n=>n.id==='j'?{...n,source:''}:n));
+  await bridge.applyQuickApply(plan.token);assert.equal(bridge.pendingQuickApply.entries[0].expectedSource,'');
+});
+test('source fallback audit feeds the source index, not only its map',async()=>{
+  const text=await fs.readFile(path.join(__dirname,'../plugin/source/Services/StudioBridge.lua'),'utf8');
+  const audit=text.split('function StudioBridge:_auditChanges()')[1].split('function StudioBridge:_nextBatch()')[0];
+  assert.ok(audit.includes('self:_sourceChanged(instance)'));assert.ok(!audit.includes('self._sourceQueue[id] = instance'));
+});
+test('a lost resume response can retry its original authorization until acknowledged',async t=>{
+  const {bridge,paired}=await harness(t);await bridge.disconnect('heartbeat-timeout');
+  const identity={studioRunId:'live-studio-process',placeKey:'1-2'};
+  const first=bridge.resume(identity,paired.token);const retry=bridge.resume(identity,paired.token);
+  assert.deepEqual(retry,first);bridge.authenticate({headers:{authorization:`Bearer ${first.token}`}});
+  assert.throws(()=>bridge.resume(identity,paired.token),/already paired/);
+});
+test('a failed final-fragment disk write retries without losing earlier fragments or duplicating revisions',async t=>{
+  const {bridge}=await harness(t);await bridge.applyOperation({type:'upsert',node:nodes[3]});
+  const parts=encodeTransfer({type:'source',id:'j',source:'--!strict\n-- '+'a'.repeat(180000)});
+  const original=bridge.backup.bind(bridge);let fail=true;
+  bridge.backup=async(...args)=>{if(fail){fail=false;throw Error('Simulated disk failure');}return original(...args);};
+  const sequence=bridge.session.lastSeq+1;const batch={sequence,ops:parts};
+  await assert.rejects(bridge.receiveChanges(batch),/disk failure/);
+  assert.equal(bridge.nodes.get('j').revision,1);
+  assert.equal(bridge.session.batchProgress.index,parts.length-1);
+  await bridge.receiveChanges(batch);assert.equal(bridge.nodes.get('j').revision,2);
+  assert.equal(bridge.session.incoming.completed,null);
+  await bridge.receiveChanges(batch);assert.equal(bridge.nodes.get('j').revision,2);
+});
+test('a retried failed batch cannot change its already checkpointed contents',async t=>{
+  const {bridge}=await harness(t);const batch={sequence:2,ops:[{type:'upsert',node:nodes[1]},null]};
+  await assert.rejects(bridge.receiveChanges(batch),/Invalid operation/);
+  assert.equal(bridge.session.batchProgress.index,1);
+  await assert.rejects(bridge.receiveChanges({sequence:2,ops:[{type:'ready'}]}),/Retried batch changed/);
+});
